# Diesen Block in die Caddyfile des Geisterstunde-Stacks (/opt/geisterstunde/Caddyfile.vps) einfügen
# und "lingo.beispiel.de" durch die echte Subdomain ersetzen (DNS-A-Eintrag auf die Server-IP nötig).
# Caddy holt das HTTPS-Zertifikat selbst.
lingo.beispiel.de {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy worklingo:8080 {
		health_uri /healthz
		health_interval 30s
	}
}
