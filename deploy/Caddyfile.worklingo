# Diesen Block an die Caddyfile des Geisterstunde-Stacks (/opt/geisterstunde/Caddyfile.vps) anhängen.
# Der Hostname löst über sslip.io ohne eigene Domain auf die Server-IP auf; Caddy holt das Zertifikat selbst.
# Mit eigener Domain: Hostnamen ersetzen und einen DNS-A-Eintrag auf die Server-IP setzen.
lingo.217-154-235-177.sslip.io {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy worklingo:8080 {
		health_uri /healthz
		health_interval 30s
	}
}
